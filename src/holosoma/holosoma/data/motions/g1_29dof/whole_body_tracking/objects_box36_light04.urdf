<?xml version="1.0" ?>
<robot name="box36_light04.urdf">
  <dynamics damping="0.5" friction="0.9"/>
  <link name="baseLink">
    <inertial>
      <!-- sim2sim mass probe: 0.4 kg (half the real 811 g box).
           Solid-cube inertia I = m*a^2/6, a = 0.36 m -->
      <mass value="0.4"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.00864" ixy="0" ixz="0" iyy="0.00864" iyz="0" izz="0.00864"/>
    </inertial>
    <contact>
      <lateral_friction value="0.9"/>
      <rolling_friction value="0.5"/>
      <stiffness value="30000"/>
      <damping value="1000"/>
    </contact>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="box36.obj" scale="1.0 1.0 1.0"/>
      </geometry>
       <material name="mat">
        <color rgba="0.6 0.9 0.6 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="box36.obj" scale="1.0 1.0 1.0"/>
      </geometry>
    </collision>
  </link>
</robot>
