<?xml version="1.0" ?>
<robot name="box36.urdf">
  <dynamics damping="0.5" friction="2.0"/>
  <link name="baseLink">
    <inertial>
      <!-- measured real box: 811 g (same crate as box32, real size 0.36 m);
           solid-cube inertia I = m*a^2/6 with a = 0.36 m -->
      <mass value="0.811"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.01752" ixy="0" ixz="0" iyy="0.01752" iyz="0" izz="0.01752"/>
    </inertial>
    <contact>
      <lateral_friction value="2.0"/>
      <rolling_friction value="1.0"/>
      <stiffness value="30000"/>
      <damping value="1000"/>
    </contact>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="box36.obj" scale="1.0 1.0 1.0"/>
      </geometry>
       <material name="mat">
        <color rgba="0.7 0.8 0.9 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="box36.obj" scale="1.0 1.0 1.0"/>
      </geometry>
    </collision>
  </link>
</robot>
